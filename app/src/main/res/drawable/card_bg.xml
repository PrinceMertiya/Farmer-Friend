<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Background color (light translucent white) -->
    <solid android:color="#80FFFFFF" />
    <!-- Rounded corner radius -->
    <corners android:radius="18dp" />
    <!-- Subtle shadow effect (optional, only works for API 21+ as elevation) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
